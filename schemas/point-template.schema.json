{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johnnyshyzt/iot-daq-gateway/blob/main/schemas/point-template.schema.json",
  "title": "PointTemplate",
  "description": "Device-class point template stored as point-templates/{metadata.id}.yaml. Many devices reference one template. M1 templates are Fanuc only (spec.adapter fanuc), shared by fanuc.fake and fanuc.focas. Point ids come from the Fanuc catalog. Internal address is filled from that catalog.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "daq.gateway/v1"
    },
    "kind": {
      "const": "PointTemplate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "displayName"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "description": "Stable template id. Must match the file name. Devices reference it as spec.pointTemplateId."
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter", "points"],
      "properties": {
        "adapter": {
          "const": "fanuc",
          "description": "Adapter family. fanuc matches both fanuc.fake and fanuc.focas. M1 has no other family."
        },
        "points": {
          "type": "array",
          "description": "Catalog points enabled for this device class, with unit, scale, and deadband defaults.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "address", "dataType"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                "description": "Fanuc catalog id: state, alarm, or program."
              },
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Internal catalog address. Studio fills state=cnc/statinfo, alarm=cnc/alarm, program=cnc/program. Collection uses the point id."
              },
              "dataType": {
                "type": "string",
                "enum": ["bool", "int32", "int64", "float", "double", "string"]
              },
              "unit": {
                "type": "string",
                "maxLength": 32
              },
              "scale": {
                "type": "number"
              },
              "deadband": {
                "type": "number",
                "minimum": 0
              },
              "enabled": {
                "type": "boolean",
                "description": "Omitted means true."
              }
            }
          }
        }
      }
    }
  }
}
