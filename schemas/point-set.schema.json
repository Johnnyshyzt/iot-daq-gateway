{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Johnnyshyzt/iot-daq-gateway/blob/main/schemas/point-set.schema.json",
  "title": "PointSet",
  "description": "Points for one device, stored as points/{metadata.deviceId}.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {
      "const": "daq.gateway/v1"
    },
    "kind": {
      "const": "PointSet"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["deviceId"],
      "properties": {
        "deviceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$",
          "description": "Must match Device.metadata.id and the file name."
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["points"],
      "properties": {
        "points": {
          "type": "array",
          "description": "Order is significant and is preserved in the revision hash. Publish requires at least one enabled point on each enabled device; an empty list is allowed in a draft.",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "address", "dataType"],
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,63}$",
                "description": "Point name used in the MQTT topic. Unique within this file."
              },
              "address": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256,
                "description": "Adapter-internal address, not a free-form protocol address. For fanuc.fake and fanuc.focas, Studio fills this from the Fanuc point catalog: state=cnc/statinfo, alarm=cnc/alarm, program=cnc/program. Collection uses the point id."
              },
              "dataType": {
                "type": "string",
                "enum": ["bool", "int32", "int64", "float", "double", "string"]
              },
              "unit": {
                "type": "string",
                "maxLength": 32
              },
              "scale": {
                "type": "number",
                "description": "Applied as value * scale before publish. Omitted means 1."
              },
              "deadband": {
                "type": "number",
                "minimum": 0,
                "description": "Absolute deadband used with changeOnly. Omitted means 0."
              },
              "enabled": {
                "type": "boolean",
                "description": "Omitted means true."
              }
            }
          }
        }
      }
    }
  }
}
