{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-daq-gateway.local/contract/northbound/1.0/rule-event",
  "title": "Rule event / 规则事件",
  "description": "Emitted on MQTT $event when a rule action type is event. Additive to northbound/1.0.",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "kind", "gatewayId", "site", "deviceId", "ruleId", "name", "ts"],
  "properties": {
    "schema": { "const": "northbound/1.0" },
    "kind": { "const": "ruleEvent" },
    "gatewayId": { "type": "string", "minLength": 1 },
    "site": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "ruleId": { "type": "string", "minLength": 1 },
    "name": { "type": "string" },
    "message": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" }
  }
}
