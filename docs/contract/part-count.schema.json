{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://iot-daq-gateway.local/contract/northbound/1.0/part-count",
  "title": "Part count / 件数",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema", "kind", "gatewayId", "site", "deviceId", "count", "quality", "ts"],
  "properties": {
    "schema": { "const": "northbound/1.0" },
    "kind": { "const": "partCount" },
    "gatewayId": { "type": "string", "minLength": 1 },
    "site": { "type": "string", "minLength": 1 },
    "deviceId": { "type": "string", "minLength": 1 },
    "count": { "type": "number" },
    "total": { "type": ["number", "null"] },
    "quality": { "type": "string" },
    "ts": { "type": "string", "format": "date-time" }
  }
}
