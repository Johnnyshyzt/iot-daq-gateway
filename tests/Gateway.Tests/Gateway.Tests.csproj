  <ItemGroup>
    <ProjectReference Include="..\..\src\Collector\Adapters.Fanuc\Adapters.Fanuc.csproj" />
    <ProjectReference Include="..\..\src\Shared\Abstractions\Gateway.Abstractions.csproj" />
    <ProjectReference Include="..\..\src\Collector\Core\Collector.csproj" />
    <ProjectReference Include="..\..\src\Collector\Sinks.Mqtt\Sinks.Mqtt.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="..\..\configs\examples\*.yaml" Link="examples\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\configs\examples\v1\**\*" Link="examples\v1\%(RecursiveDir)%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>
