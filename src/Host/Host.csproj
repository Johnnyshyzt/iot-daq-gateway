<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <RootNamespace>IotDaq.Host</RootNamespace>
    <AssemblyName>Host</AssemblyName>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>
    <Product>IoT DAQ Host</Product>
    <Description>Single process: management API, Fanuc acquisition, and static Web.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Api\Management\Api.csproj" />
    <ProjectReference Include="..\Collector\Core\Collector.csproj" />
    <ProjectReference Include="..\Collector\Sinks.OpcUa\Sinks.OpcUa.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\data\seed\**\*" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="data\seed\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="..\..\docs\contract\**\*.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="contract\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="..\..\docs\manual\现场调试清单.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="docs\现场调试清单.md" />
  </ItemGroup>
  <ItemGroup Condition="Exists('..\Web\dist\index.html')">
    <Content Include="..\Web\dist\**\*" CopyToPublishDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
