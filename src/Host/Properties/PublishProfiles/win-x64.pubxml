<?xml version="1.0" encoding="utf-8"?>
<Project>
  <!--
    Factory PCs usually have neither the .NET SDK nor a shared 10.0 runtime.
    Self-contained win-x64 is the production publish: larger zip, zero runtime install.
    Do not enable PublishSingleFile — Fwlib64.dll must sit next to Host.exe
    and DllImport search uses the process directory.
  -->
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishDir>..\..\artifacts\win-x64\payload\</PublishDir>
  </PropertyGroup>
</Project>
